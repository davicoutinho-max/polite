# Copy this file to .env in this same directory and fill in a real key.
# Get a Gemini API key from https://aistudio.google.com/apikey — never commit the real .env file
# (it's already gitignored via backends/**/.env).

GEMINI_API_KEY=
# Optional overrides — safe to leave commented out.
# GEMINI_MODEL=gemini-2.5-flash
# GEMINI_BASE_URL=https://generativelanguage.googleapis.com
