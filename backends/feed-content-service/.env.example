# Copy this file to .env in this same directory and fill in your real Meta/X app credentials.
# Never commit the real .env file (it's already gitignored via backends/**/.env).

# --- Meta (Facebook + Instagram) ---
# Create an app at https://developers.facebook.com, add the "Facebook Login" product, and add
# META_REDIRECT_URI (see below) as one of its valid OAuth redirect URIs exactly (byte-for-byte).
# Production use of pages_manage_posts/instagram_content_publish requires Meta's App Review —
# until then this only works for the app's own developers/testers added in the Meta dashboard.
META_APP_ID=
META_APP_SECRET=
# Must match what's registered in the Meta app AND be reachable through the gateway (not this
# service's own port) since Meta redirects the citizen's browser here directly.
# META_REDIRECT_URI=http://localhost:8080/api/feed/social-connections/meta/callback
# META_GRAPH_API_VERSION=v21.0

# --- X (Twitter) ---
# Create an app at https://developer.x.com, enable "OAuth 2.0" with type "Confidential client",
# and register X_REDIRECT_URI as its callback URL. Posting tweets via the API requires at least
# X's paid "Basic" access tier — the free tier is read-only.
X_CLIENT_ID=
X_CLIENT_SECRET=
# X_REDIRECT_URI=http://localhost:8080/api/feed/social-connections/x/callback

# Where the citizen's browser is redirected after a connect flow finishes — the frontend's own
# origin, not this service's.
# FRONTEND_BASE_URL=http://localhost:4200
