# Copy this file to .env in this same directory and fill in your real Resend key.
# Get a key from https://resend.com/api-keys — never commit the real .env file (it's already
# gitignored via backends/**/.env).

RESEND_API_KEY=
# Resend's own shared sandbox sender — works out of the box for testing, but only delivers to the
# email address you signed up to Resend with. Verify your own domain in the Resend dashboard and
# set this to an address on it (e.g. "CivicPulse <noreply@yourdomain.com>") to send to anyone.
# RESEND_FROM_ADDRESS=CivicPulse <onboarding@resend.dev>
