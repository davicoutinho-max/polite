# Copy this file to .env in this same directory and fill in your real Asaas keys.
# Create a sandbox account at https://www.asaas.com/login/criarConta (or use an existing account's
# Sandbox toggle) and grab the API key from Integrations > API. Never commit the real .env file
# (it's already gitignored via backends/**/.env).

ASAAS_API_KEY=
# Sandbox by default (see application.yml) — switch to https://api.asaas.com/v3 only once
# genuinely ready to move real money.
# ASAAS_BASE_URL=https://api-sandbox.asaas.com/v3

# Set the same value here and in the Asaas dashboard's webhook settings (Integrations > Webhooks)
# — Asaas sends it back on every webhook call as the asaas-access-token header, and
# AsaasWebhookController compares it before trusting any event. Any long random string works;
# it's a shared secret you choose, not something Asaas issues.
ASAAS_WEBHOOK_TOKEN=
